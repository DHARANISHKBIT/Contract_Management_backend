PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/contractDB
JWT_SECRET=use-a-long-random-string-in-production

# Comma-separated browser origins allowed to call this API (required for production hardening)
# Example: https://my-app.vercel.app,http://localhost:5173
# CORS_ORIGINS=https://your-frontend.example.com

# Single frontend URL (alternative to CORS_ORIGINS; one value only unless you use CORS_ORIGINS)
# FRONTEND_URL=https://your-frontend.example.com
